HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Render / production: public URL of this Strapi service (no trailing slash); trust reverse proxy
# PUBLIC_URL=https://your-strapi-service.onrender.com
# SERVER_PROXY=true

# Comma-separated origins allowed to call the API (your frontend URL(s))
# CORS_ORIGIN=https://humanist-ai.onrender.com,http://localhost:8080

# Database: sqlite | mysql | postgres
# DATABASE_CLIENT=postgres
# Local dev against Render: use External Database URL only (Internal URL works only on Render)
# DATABASE_URL=postgresql://user:password@HOST.REGION.postgres.render.com/database
# DATABASE_SSL=true

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
