HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Render / production: public URL of this Strapi service (no trailing slash); trust reverse proxy
# PUBLIC_URL=https://your-strapi-service.onrender.com
# SERVER_PROXY=true

# Comma-separated origins allowed to call the API (your frontend URL(s))
# CORS_ORIGIN=https://humanist-ai.onrender.com,http://localhost:8080

# Database: sqlite | mysql | postgres
#
# --- MySQL (local example) ---
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=strapi
# DATABASE_USERNAME=root
# DATABASE_PASSWORD=
# DATABASE_SSL=false
#
# --- Postgres ---
# DATABASE_CLIENT=postgres
# Local: STRAPI_DATABASE_URL = External URL (takes priority over DATABASE_URL — fixes Windows env conflicts)
# STRAPI_DATABASE_URL=postgresql://user:password@HOST.REGION.postgres.render.com/database
# Render: DATABASE_URL = Internal URL only; omit STRAPI_DATABASE_URL
# DATABASE_URL=postgresql://...
# DATABASE_SSL=true

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Media Library: default is local disk under public/uploads/YYYY/MM/DD/ (see providers/upload-local-dated).
# Cloudflare R2 is not used by config/plugins.ts unless you switch back to aws-s3 provider; R2_* below keep for reference.
# Cloudflare R2 — endpoint has NO bucket in the path (bucket is R2_BUCKET only)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=humanist-ai
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev   (or custom domain; no trailing slash)

# Native news pipeline (do not commit real values)
NEWSAPI_KEY=
GEMINI_API_KEY=
# Gemini mock mode is a dashboard toggle (Settings → Gemini mock mode), not an env var.
# Optional. Do not set lite for article writing — the pipeline uses gemini-2.5-flash for the body.
# GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: cheapest GA image model is the default (@cf/black-forest-labs/flux-1-schnell)
# CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell
PIPELINE_DASHBOARD_TOKEN=
# PIPELINE_ARTICLE_AUTHOR=Editorial Team
# Set true once to trigger a run on Strapi boot (then unset)
# PIPELINE_RUN_NOW=true

# Newsletter (Brevo). API key from Brevo → SMTP & API → API keys.
# On first subscribe the backend creates a list named BREVO_LIST_NAME if it does not exist.
# BREVO_API_KEY=
# BREVO_LIST_NAME=The Humanist AI Newsletter
# Optional: skip auto-create and use an existing list id
# BREVO_LIST_ID=
