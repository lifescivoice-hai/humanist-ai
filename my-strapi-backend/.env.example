HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Render / production: public URL of this Strapi service (no trailing slash); trust reverse proxy
# PUBLIC_URL=https://your-strapi-service.onrender.com
# SERVER_PROXY=true

# Comma-separated origins allowed to call the API (your frontend URL(s))
# CORS_ORIGIN=https://humanist-ai.onrender.com,http://localhost:8080

# Database: sqlite | mysql | postgres
# DATABASE_CLIENT=postgres
# Local: STRAPI_DATABASE_URL = External URL (takes priority over DATABASE_URL — fixes Windows env conflicts)
# STRAPI_DATABASE_URL=postgresql://user:password@HOST.REGION.postgres.render.com/database
# Render: DATABASE_URL = Internal URL only; omit STRAPI_DATABASE_URL
# DATABASE_URL=postgresql://...
# DATABASE_SSL=true

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Cloudflare R2 — endpoint has NO bucket in the path (bucket is R2_BUCKET only)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=humanist-ai
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev   (or custom domain; no trailing slash)
